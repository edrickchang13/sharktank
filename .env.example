# LiveKit Cloud credentials (replaces TRTC)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# LemonSlice for avatar video generation
LEMONSLICE_API_KEY=

# Google Gemini Live (LLM + native audio for the judge personalities)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Mood vision model (separate quota from Gemini Live above)
MOOD_MODEL=gemini-2.5-flash
MOOD_MIN_INTERVAL_S=8.0
MOOD_BACKOFF_S=30.0

# Avatar reference images per judge (optional overrides, can host on imgur etc)
CUBAN_AVATAR_URL=https://iili.io/frL9tuj.png
OLEARY_AVATAR_URL=https://iili.io/frL9L8u.png
CORCORAN_AVATAR_URL=https://iili.io/frL9Qyb.png

# Tencent Cloud Object Storage (still used for session JSON logging)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=
COS_REGION=na-siliconvalley
