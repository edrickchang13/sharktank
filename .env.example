# P1's scope: TRTC credentials, ElevenLabs voices, and COS session logging.
# Hunyuan / Tencent TTS / IVH were dropped during the stack pivot.
# P2 owns Gemini Live + ElevenLabs TTS at runtime; P1 hands over keys and prompts.

# Tencent CAM (used only by COS now)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Tencent TRTC (hand SDKAppID + SecretKey to P2 for tencent.Edge transport)
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# ElevenLabs (hand API key + 3 voice IDs to P2 for elevenlabs.TTS)
# Defaults below are recommended free-tier voices. Audition before locking.
# Cuban  = Brian (middle-aged male, deep and confident)
# OLeary = Bill  (older male, dry and authoritative)
# Barbara= Alice (middle-aged female, confident news)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_CUBAN=nPczCjzI2devNBz1zQrb
ELEVENLABS_VOICE_OLEARY=pqHfZKP75CvOlQylNhV4
ELEVENLABS_VOICE_CORCORAN=Xb7hH8MSUJpSbSDYk0k2

# Tencent COS (P1 owns session JSON + per-turn audio uploads)
COS_BUCKET=
COS_REGION=ap-guangzhou
