# Tencent Cloud base credentials (CAM API key — used by Hunyuan, TTS, COS)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# Hunyuan (LLM for judge personalities)
HUNYUAN_MODEL=hunyuan-lite

# TTS (3 distinct voices — recommended IDs, audition before locking in)
# Cuban  = WeJames (501008, English large-model male, punchy)
# OLeary = WeJack  (101050, English premium male, dry/measured)
# Barbara= WeWinny (501009, English large-model female, natural warmth)
# 501xxx may be Beijing/Shanghai region only — fall back to 1050/1051 if unavailable
TTS_VOICE_CUBAN=501008
TTS_VOICE_OLEARY=101050
TTS_VOICE_CORCORAN=501009

# IVH / Digital Human (avatar IDs from preset catalog)
IVH_AVATAR_CUBAN=
IVH_AVATAR_OLEARY=
IVH_AVATAR_CORCORAN=

# TRTC (streaming — separate from CAM credentials, from console.trtc.io)
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# COS (session storage)
COS_BUCKET=
COS_REGION=ap-guangzhou
