# LiveKit Cloud credentials (replaces TRTC)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# LemonSlice for avatar video generation
LEMONSLICE_API_KEY=

# Google Gemini Live (LLM + native audio for the judge personalities)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Mood vision model (separate quota from Gemini Live above)
MOOD_MODEL=gemini-2.5-flash
MOOD_MIN_INTERVAL_S=8.0
MOOD_BACKOFF_S=30.0

# Avatar reference images per judge. Defaults are Wikimedia Commons photos
# (CC BY 2.0 licensed, free to use with attribution). Replace with your own
# imgur or self-hosted URLs if you want different framing or AI-stylized art.
CUBAN_AVATAR_URL=https://upload.wikimedia.org/wikipedia/commons/3/3c/Mark_Cuban%2C_Web_2.0_Conference.jpg
OLEARY_AVATAR_URL=https://upload.wikimedia.org/wikipedia/commons/8/82/Kevin_O%27Leary_2012.jpg
CORCORAN_AVATAR_URL=https://upload.wikimedia.org/wikipedia/commons/c/c3/Barbara_Corcoran.jpg

# Pitch timer (seconds). Judges are instructed to listen silently for this
# many seconds before asking their first question. Frontend shows a countdown
# in the header. Set to 0 to disable the silent pitch phase entirely.
PITCH_TIMER_SECONDS=60

# Tencent Cloud Object Storage (still used for session JSON logging)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=
COS_REGION=na-siliconvalley
