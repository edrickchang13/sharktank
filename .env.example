# This repo's final scope: TRTC + Google + COS session logging.
# ElevenLabs dropped. Vision Agents gemini.Realtime ships with
# response_modalities=[AUDIO] by default, no TTS plugin needed.

# Tencent CAM (used only by COS now)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Tencent TRTC (hand SDKAppID + SecretKey to the Vision Agents backend for tencent.Edge transport)
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# Google Gemini Live (hand to the Vision Agents backend for gemini.Realtime native audio output)
# Voice mapping for the judges (set in the Vision Agents backend init, not here):
#   Cuban  -> Charon  (deep, authoritative)
#   OLeary -> Orus    (crisp, sharp)
#   Barbara-> Aoede   (warm, female)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Tencent COS (this repo owns session JSON + per-turn audio uploads)
COS_BUCKET=
COS_REGION=ap-guangzhou
